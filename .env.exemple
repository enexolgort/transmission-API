# Transmission daemon connection
TRANSMISSION_HOST=127.0.0.1
TRANSMISSION_PORT=9091
TRANSMISSION_RPC_PATH=/transmission/rpc
TRANSMISSION_PROTOCOL=http
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=

# This wrapper API
PORT=3000
# Optional: require an X-API-Key header on every request to this API
API_KEY=

# --- Docker Compose VPN routing (haugene/transmission-openvpn) ---
# From PureVPN's Member Area (Subscriptions section) — this is the
# VPN-specific username/password, NOT your account login.
PUREVPN_USERNAME=
PUREVPN_PASSWORD=
# Filename of your .ovpn file placed in ./vpn-config, without the extension
# (e.g. if the file is ./vpn-config/purevpn.ovpn, leave this as "purevpn").
OPENVPN_CONFIG=purevpn

# --- SFTP push (POST /torrents/:id/push-sftp) ---
# Your SSH private key itself goes at ./sftp-keys/id_ed25519 (see docker-compose.yml)
# — it's not an env var. These are just the connection details.
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
# Only needed if your private key is itself passphrase-protected:
SFTP_PRIVATE_KEY_PASSPHRASE=
